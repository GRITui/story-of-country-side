; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are defined by the engine.

config_version=5

[application]

config/name="Story of Country Side"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/main_scene="res://scenes/ui/TitleScreen.tscn"

[autoload]
InputMapManager="*res://scripts/autoload/input_map_manager.gd"
